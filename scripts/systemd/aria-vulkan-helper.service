# ARIA Phase 8 RX 7600 Vulkan helper: small models only (<= Qwen3.5:4B size,
# 4096 context), one model and one request at a time. Placement and limits are
# enforced by jarvis/gpu_scheduler.py; FTR runtimes are separate and untouched.
[Unit]
Description=ARIA RX 7600 Vulkan helper (Phase 8)
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11448
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
Environment=OLLAMA_NOPRUNE=1
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=2
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_GPU_OVERHEAD=2147483648
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=OLLAMA_VULKAN=1
Environment=GGML_VK_VISIBLE_DEVICES=0
Environment=HIP_VISIBLE_DEVICES=-1
Environment=ROCR_VISIBLE_DEVICES=-1
Environment=HOME=%h/.local/share/aria-vulkan-helper
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/aria-vulkan-helper
ExecStart=/usr/local/bin/ollama serve
Nice=5
MemoryMax=10G
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
